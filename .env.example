# Copy this file to .env and fill in the real values. .env is never committed.
# The word between the host and the "?" is the database name (classpoll).
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/classpoll?retryWrites=true&w=majority
# Needed to open /results. Pick any long random-looking text.
ADMIN_KEY=
PORT=3000
